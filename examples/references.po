## References: pass a variable by reference and mutate the caller.

fun increment(value: &int) {
    value += 1;
}

fun swap(first: &int, second: &int) {
    temporary := first;
    first = second;
    second = temporary;
}

fun add_all(target: &int, amounts: arr) {
    for amount >> amounts {
        target += amount;
    }
}

counter := 10;
increment(&counter);
print(counter);
print("\n");

left := 1;
right := 2;
swap(&left, &right);
print(left);
print(" ");
print(right);
print("\n");

total := 0;
add_all(&total, [1 2 3 4]);
print(total);
print("\n");

fun doubled(value: &int): int {
    return value * 2;
}

print(doubled(&counter));
print("\n");

limit: int! = 5;
try {
    ## increment(&limit);
    print("constants are protected\n");
} catch problem {
    print(problem.kind + "\n");
}
