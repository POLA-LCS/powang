## spawn accepts method and static method calls.

type Worker[+] {
    | value: int;

    fun this.double(): int >> this.value * 2;
    fun triple(value: int): int >> value * 3;
}

fun run() {
    worker := Worker.[7];

    method_task := spawn worker.double();
    static_task := spawn Worker.triple(5);

    print(wait(method_task));
    print(" ");
    print(wait(static_task));
    print("\n");
}

run();
