## Tasks: spawn a function call on a worker thread and wait for the result.

fun sum_squares(limit: int): int {
    total: int = 0;
    for index := 0; index < limit; index += 1 {
        total += index * index;
    }
    return total;
}

fun run() {
    first := spawn sum_squares(100);
    second := spawn sum_squares(200);

    print(typeof(first));
    print(" ");

    print(wait(first));
    print(" ");
    print(wait(second));
    print("\n");
}

run();

## Typed task handles and spawned method calls.
type Worker[+] {
    | value: int;

    fun this.double(): int >> this.value * 2;
    fun triple(value: int): int >> value * 3;
}

fun run_methods() {
    worker := Worker.[7];
    method_task: task = spawn worker.double();
    static_task: task = spawn Worker.triple(5);

    print(typeof(method_task));
    print(" ");
    print(wait(method_task));
    print(" ");
    print(wait(static_task));
    print("\n");
}

run_methods();
