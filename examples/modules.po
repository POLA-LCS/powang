## Modules: namespaces, aliases, wildcard imports and exports.

use "./lib/greeting.po" as greeting;
use "./lib/greeting.po" as *;

output(greeting.hello("powang"));
output("\n");

output(greeting.shout("powang"));
output("\n");

## Wildcard import exposes the exported names directly.
output(hello("wildcard"));
output("\n");
output(shout("wildcard"));
output("\n");
