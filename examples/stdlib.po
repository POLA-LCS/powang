## Standard library: strings, json, url and crypto.

use strings;
use json;
use url;
use crypto;

print(strings.trim("  spaced  "));
print("\n");

payload := ["name" >> "powang", "ok" >> true, "count" >> 3];
encoded := json.stringify(payload);
print(encoded);
print("\n");

decoded := json.parse(encoded);
print(decoded["name"]);
print(" ");
print(decoded["count"]);
print("\n");

print(url.encode("a b&c"));
print(" ");
print(url.query_build(["q" >> "powang docs", "page" >> 2]));
print("\n");

print(crypto.sha256("abc"));
print("\n");

print(crypto.constant_time_compare("secret", "secret"));
print(" ");
print(crypto.constant_time_compare("secret", "other"));
print("\n");
