## Arithmetics: int, num, bool, str and arr operators.

print(7 + 3); ## 10
print("\n");
print(7 - 3); ## 4
print("\n");
print(7 * 3); ## 21
print("\n");
print(7 / 3); ## 2
print("\n");
print(7 / 0); ## nova
print("\n");

print(1.5 + 1); ## 2.5
print("\n");
print(7.0 / 2.0); ## 3.5
print("\n");

printf("{0}\n", 2 + 0.5); ## 2

print(true + true); ## true
print("\n");
print(true - false); ## true
print("\n");
print(true * false); ## false
print("\n");

printf("{0}\n", "ab" * 3); ## ababab
print("abcd" / 2); ## [ab, cd]
print("\n");
print("a,b,c" / ","); ## [a, b, c]
print("\n");

print([1 2] + [3 4]); ## 1, 2, 3, 4
print("\n");
print([1 2 3 4] - 2); ## 1, 2
print("\n");
print(2 / [1 2 3 4]); ## [[1, 2], [3, 4]]
print("\n");
