## This is an example for the powang language (https://github.com/POLA-LCS/powang)
## Logical operators
## Any operation with a bool with it's main operand cast all of the values into bools

## + A B = A or B      ## A +  B ##
## - A B = A or not B  ## A + ~B ## != NOR  => ~(A + B)
## * A B = A and B     ## A *  B ##
## / A B = A and not B ## A * ~B ## != NAND => ~(A * B)

## Run this script to check the outputs
## If by any the outputs are different than this    vvvvv
## We have a problem...

## OR                                            ## OR
print ['OR' '__________________']                ##
print [(+ false false) '|' 'expect:' 'false']    ## false
print [(+ false true) '\a32|' 'expect:' 'true']  ## true
print [(+ true false) '\a32|' 'expect:' 'true']  ## true
print [(+ true true) '\a32|' 'expect:' 'true']   ## true
                                                 ##
## AND                                           ## AND
print ['\nAND' '_________________']              ##
print [(* false false) '|' 'expect:' 'false']    ## false
print [(* false true) '|' 'expect:' 'false']     ## false
print [(* true false) '|' 'expect:' 'false']     ## false
print [(* true true) '\a32|' 'expect:' 'true']   ## true
                                                 ##
## OR not                                        ## OR not
print ['\nOR' 'not' '______________']            ##
print [(- false false) '\a32|' 'expect:' 'true'] ## true
print [(- false true) '|' 'expect:' 'false']     ## false
print [(- true false) '\a32|' 'expect:' 'true']  ## true
print [(- true true) '\a32|' 'expect:' 'true']   ## true
                                                 ##
## AND not                                       ## AND not
print ['\nAND' 'not' '_____________']            ##
print [(/ false false) '|' 'expect:' 'false']    ## false
print [(/ false true) '|' 'expect:' 'false']     ## false
print [(/ true false) '\a32|' 'expect:' 'true']  ## true
print [(/ true true) '|' 'expect:' 'false']      ## false