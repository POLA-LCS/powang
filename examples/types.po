## User-defined types: constructors, public and private members, methods.

type Point {
    + x: int;
    - y: int = 7;

    + fun constructor(px: int): Point {
        this.x = px;
    }

    + fun sum(other: Point): int {
        return this.x + other.x;
    }

    + fun describe(): str {
        return "Point(" + (this.x as str) + ", " + (this.y as str) + ")";
    }
}

first := [5] as Point;
second: Point = 9;

print(first.x);
print(" ");
print(first.sum(second));
print("\n");

print(first.describe());
print("\n");

## y is private and reachable through a method.
print(second.describe());
print("\n");

## Instances copy by value.
copy := first;
copy.x = 100;
print(first.x);
print(" ");
print(copy.x);
print("\n");
