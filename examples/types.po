## User-defined types: constructors, public and private members, methods.

type Point {
    + x: integer;
    - y: integer = 7;

    + fun constructor(px: integer): Point {
        this.x = px;
    }

    + fun sum(other: Point): integer {
        return this.x + other.x;
    }

    + fun describe(): string {
        return "Point(" + (this.x as string) + ", " + (this.y as string) + ")";
    }
}

first := [5] as Point;
second: Point = 9;

print(first.x);
print(" ");
print(first.sum(second));
print("\n");

print(first.describe());
print("\n");

## y is private and reachable through a method.
print(second.describe());
print("\n");

## Instances copy by value.
copy := first;
copy.x = 100;
print(first.x);
print(" ");
print(copy.x);
print("\n");
