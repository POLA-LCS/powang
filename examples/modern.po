## Modern syntax tour: comments, interpolation, destructuring, ranges, match,
## null safety, named arguments, pipelines, const macros, loops, slicing,
## lambdas and function types.

use strings;

const MAX_SCORE: int = 100;
const LABEL = "powang";

println($"== {LABEL} ==");
println($"max score: {MAX_SCORE}");

#! 
Block comments can span
more than one line. 
!#

## Trailing commas are allowed.
numbers := [1, 2, 3];
pairs := ["a" >> 1, "b" >> 2,];

## Range iteration: start, step, end. The end is exclusive.
for i >> 0 >> 2 >> 6 {
    print(i);
    print(" ");
}
println("");

## arr destructuring.
[a, b] := numbers;
println($"first={a} second={b}");

## Typed for-each destructuring.
for [key: str, value: int] >> pairs {
    println($"{key}={value}");
}

## Match with guards.
fun classify(value: int): str {
    match value {
        case 0 >> return "zero";
        case n if n < 0 >> return "negative";
        case _ >> return "positive";
    }
}

println(classify(-3));
println(classify(0));
println(classify(7));

## Null safety and a declaration in an if condition.
missing: @str = nova;
println(missing ?? "fallback");
if found := missing {
    println(found);
} else {
    println("not found");
}

## Named arguments, expression-bodied functions and pipelines.
fun greet(name: str = LABEL, punctuation: str = "!"): str >> $"Hello, {name}{punctuation}";

println(greet());
println(greet(name >> "Ada"));
println("  trim me  " :> strings.trim :> strings.upper);

## Loop forms and labels.
index := 0;
loop if index < 3 {
    index += 1;
}
println($"loop index: {index}");

## Slicing and negative indexing.
println("abcdef"[1 >> 4]);
println("abcdef"[-1]);

## Lambdas and function types.
double := fun(value: int): int >> value * 2;
apply: fun[fun[int, int], int, int] =
    fun(function: fun[int, int], value: int): int >> function(value);
println(apply(double, 5));
