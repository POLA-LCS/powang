## Collections and strings: typed arrays, maps, indexing, modulo and the strings module.

use strings;

numbers: arr[int] = [10 20 30];
print(numbers);
print(" ");
print(size(numbers));
print("\n");

numbers[1] = 25;
print(numbers[1]);
print("\n");

## A bare arr annotation is sugar for arr[any].
mixed: arr = [1 "two" true];
print(size(mixed));
print("\n");

## Element types are checked on declarations, calls and returns.
typed_names: arr[str] = ["ada" "grace"];
print(typed_names[1]);
print("\n");

pairs := ["name" >> "powang", "kind" >> "language"];
pairs = pairs + ["year" >> 2025];
print(pairs["name"]);
print(" ");
print(size(pairs));
print("\n");

## arr arithmetic
print([1 2] + [3 4]);
print(" ");
print([1 2 3 4] - 2);
print(" ");
print([1 2 3] - [2]);
print("\n");

## str helpers
print(strings.trim("  text  "));
print(" ");
print(strings.upper("powang"));
print(" ");
print(strings.replace("a-b-c", "-", "+"));
print("\n");

print(strings.split("a,b,c", ","));
print(" ");
print(strings.join(["a", "b"], "-"));
print(" ");
print(strings.repeat("ab", 3));
print("\n");

## format builds a str without printing it.
print(format("{0}/{1}", "a", "b"));
print("\n");

## Modulo and exponent literals
print(17 % 5);
print(" ");
print(2e3);
print("\n");
