## Error handling: raising, catching, error unions and `?` propagation.

fun validate(value: int): int? {
    if value < 0 {
        return fail("VALUE", "negative input", "value=" + (value as str));
    }
    return value;
}

fun double(value: int): int? {
    checked := validate(value)?;
    return checked * 2;
}

print(double(5));
print("\n");

rejected := double(-5);
print(typeof(rejected));
print(" ");
print(rejected.kind);
print(" ");
print(rejected.message);
print("\n");

try {
    error("boom", "first detail", "second detail");
} catch problem {
    print(problem.kind);
    print(" ");
    print(problem.message);
    print(" ");
    print(size(problem.details));
    print("\n");
}

try {
    "abc" / 0;
} catch problem {
    print(problem.kind);
    print(": ");
    print(problem.message);
    print("\n");
}

## `?` returns the error value from the enclosing function.
fun load(value: int): int? {
    loaded := double(value)?;
    if loaded > 100 {
        return fail("RANGE", "too large");
    }
    return loaded;
}

small := load(10);
print(small);
print("\n");

large := load(1000);
print(large.kind);
print("\n");

## Caught errors expose the call stack in frames.
fun inner(): int {
    error("inner failure");
}

fun outer(): int {
    return inner();
}

try {
    outer();
} catch problem {
    print("frames: ");
    print(size(problem.frames));
    print("\n");
    for frame >> problem.frames {
        print(frame);
        print("\n");
    }
}
