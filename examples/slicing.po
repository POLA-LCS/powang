## Slicing uses from >> to with optional bounds.
## Negative indices count from the end.

text := "abcdef";
print(text[>>]);
print(" ");
print(text[2 >>]);
print(" ");
print(text[>> 3]);
print(" ");
print(text[1 >> 4]);
print("\n");

print(text[-3 >>]);
print(" ");
print(text[>> -1]);
print(" ");
print(text[-1]);
print("\n");

numbers := [10, 20, 30, 40];
print(numbers[1 >> 3]);
print(" ");
print(numbers[>> 2]);
print(" ");
print(numbers[-2 >>]);
print("\n");

pair := .[1, 2, 3, 4];
print(pair[1 >> 3]);
print("\n");
