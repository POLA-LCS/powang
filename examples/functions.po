## Functions: declarations, return types and overload resolution.

a: integer = 20;
b: number = 1.5;

fun add(left: integer, right: integer): integer {
	return left + right;
}

print(add(a, b) "\n"); ## 21

fun add(left: integer, right: number): number {
	return left +: right;
}

print(add(a, b) "\n"); ## 21.5
