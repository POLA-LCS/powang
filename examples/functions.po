## If the function has no return type, it assumes to be nova
## If the function has no return value, it assumes to ve nova

a: integer = 20;
b: number = 1.5;

fun add(left: integer, right: integer): integer {
	return a + b;
}

output(add(a, b) "\n"); ## 21

## If you have multiple definitions there is a points system
## that decided what function should use based on
## argument number matching
## min argumetn number matching
## type match
## implicit type cast
## its a weak var?
## its a const var?

fun add(left: integer, right: number): number {
	return a +: b; ## Inverse implicit cast operator
	## It is like doing (a as b type) + b but implicitly
}

## Now doing add(a, b) uses the function with the right types
output(add(a, b) "\n"); ## 21.5