## Character values are Unicode scalar values.
##
## char literals use single quotes. String indexing and string iteration yield
## char. Slicing still yields str, and str.chars materializes an arr[char].

ch: char = 'A';
print(ch); print(" "); print(ord(ch)); print(" "); println(size(ch));

text := "héllo";
println(text);
println(text.chars());
println(text[1]);
println(text[-1]);
println(typeof(text[1]));
println(typedeep(text.chars()));

print('a' < 'b'); print(" ");
print('a' == "a"); print(" ");
println('z' > 'a');

println("x" + 'y');
println('a' + "b");
println('a' + 'b');

print(is_digit('7')); print(" ");
print(is_alpha('A')); print(" ");
print(is_alnum('9')); print(" ");
print(is_space(' ')); print(" ");
print(is_upper('A')); print(" ");
print(is_lower('a')); print(" ");
println(is_ascii('é'));

println(digit_value('7'));
println(digit_value('x'));

println('G'.code());
println('G'.to_str());
println('G'.is_alpha());
println('7'.is_digit());
println('😀'.is_ascii());

println(str.['S']);
println(char.["C"]);
println("Z" as char);

println(chr(128512));
println(ord('😀'));

for character >> "abc" {
    print(character);
    print(" ");
}
println("");

for character >> "abc".chars() {
    print(character);
    print(" ");
}
println("");

seen := [/ 'a', 'b', 'a'];
print(size(seen)); print(" "); println(set.has(seen, 'a'));

mapping := ['k' >> 1];
println(mapping['k']);

println('q' match {
    case 'a' >> "alpha"
    case 'q' >> "qwerty"
    case _ >> "other"
});
