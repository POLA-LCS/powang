## Operator overloading uses the built-in Add, Subtract, Multiply, Negate
## and Compare traits. A type overloads an operator by declaring the matching
## instance method.

type Vector[+] {
    | x: int;
    | y: int;

    fun this.add(other: Vector): Vector >> Vector.[this.x + other.x, this.y + other.y];
    fun this.subtract(other: Vector): Vector >> Vector.[this.x - other.x, this.y - other.y];
    fun this.multiply(scale: int): Vector >> Vector.[this.x * scale, this.y * scale];
    fun this.negate(): Vector >> Vector.[-this.x, -this.y];
    fun this.compare(other: Vector): int {
        if this.x < other.x {
            return -1;
        }
        if this.x > other.x {
            return 1;
        }
        return this.y - other.y;
    }
    fun this.repr(): str >> $"({this.x}; {this.y})";
}

left := Vector.[1, 2];
right := Vector.[3, 4];

sum := left + right;
print($"sum={sum.repr()}"); print("\n");

difference := left - right;
print($"difference={difference.repr()}"); print("\n");

scaled := left * 3;
print($"scaled={scaled.repr()}"); print("\n");

negated := -left;
print($"negated={negated.repr()}"); print("\n");

print($"less={left < right}"); print("\n");
print($"equal={left == right}"); print("\n");

left += right;
print($"compound={left.repr()}"); print("\n");
