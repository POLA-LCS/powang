## This is an example for the powang language (https://github.com/POLA-LCS/powang)
## IF STATEMENT

## Change this values to see the behaviour of the script.
var number_val 10
var expression (if (- number_val 10) false true ends)

if true
    print ['True' 'from' 'if']
else expression ## compares it to 10
    print ['True' 'from' 'else']
else
    print ['False' 'from' 'else']
ends

var quick_if_value (if (* expression true) 69 420)
    print ['Quick' 'if' 'value' 'true' 'returns' quick_if_value]
else
    print ['Quick' 'if' 'value' 'false' 'returns' quick_if_value]
ends