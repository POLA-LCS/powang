## Control flow: if/else, C-style for, for-each and try/catch/finally.

fun classify(value: int): str {
    if value < 0 {
        return "negative";
    } else if value == 0 {
        return "zero";
    } else {
        return "positive";
    }
}

print(classify(-4) + " " + classify(0) + " " + classify(9) + "\n");

for index := 0; index < 3; index += 1 {
    print(index);
    print(" ");
}
print("\n");

numbers := [10 20 30];

## Typed iterator
for n: int >> numbers {
    print(n);
    print(" ");
}
print("\n");

## Bare identifier, implicitly weakly typed
for n >> numbers {
    print(n);
    print(" ");
}
print("\n");

## Filtered iteration
for n >> numbers if n > 15 {
    print(n);
    print(" ");
}
print("\n");

## Strings and maps are iterable too
for letter >> "abc" {
    print(letter);
}
print("\n");

for pair >> ["a" >> 1, "b" >> 2] {
    print(pair[0] + "=" + (pair[1] as str) + " ");
}
print("\n");

## try/catch/finally
fun divide(a: int, b: int): int {
    try {
        if b == 0 {
            error("division by zero");
        }
        return a / b;
    } catch problem {
        print("caught " + problem.kind + ": " + problem.message + "\n");
        return 0;
    } finally {
        print("cleanup\n");
    }
}

print(divide(9, 3));
print("\n");
print(divide(9, 0));
print("\n");

## loop if checks its condition before each iteration.
index := 0;
loop if index < 3 {
    index += 1;
}
print("loop if: ");
print(index);
print("\n");

## A label lets break target an outer loop.
found := false;
for |rows| row >> 0 >> 3 {
    for column >> 0 >> 3 {
        if row == 1 && column == 1 {
            found = true;
            break rows;
        }
    }
}
print("labeled break: ");
print(found);
print("\n");
