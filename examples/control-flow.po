## Control flow: if/else, C-style for, for-each and try/catch/finally.

fun classify(value: integer): string {
    if value < 0 {
        return "negative";
    } else if value == 0 {
        return "zero";
    } else {
        return "positive";
    }
}

print(classify(-4) + " " + classify(0) + " " + classify(9) + "\n");

for index := 0; index < 3; index += 1 {
    print(index);
    print(" ");
}
print("\n");

numbers := [10 20 30];

## Typed iterator
for number: integer >> numbers {
    print(number);
    print(" ");
}
print("\n");

## Bare identifier, implicitly weakly typed
for number >> numbers {
    print(number);
    print(" ");
}
print("\n");

## Filtered iteration
for number >> numbers if number > 15 {
    print(number);
    print(" ");
}
print("\n");

## Strings and maps are iterable too
for letter >> "abc" {
    print(letter);
}
print("\n");

for pair >> ["a" >> 1, "b" >> 2] {
    print(pair[0] + "=" + (pair[1] as string) + " ");
}
print("\n");

## try/catch/finally
fun divide(a: integer, b: integer): integer {
    try {
        if b == 0 {
            error("division by zero");
        }
        return a / b;
    } catch problem {
        print("caught " + problem.kind + ": " + problem.message + "\n");
        return 0;
    } finally {
        print("cleanup\n");
    }
}

print(divide(9, 3));
print("\n");
print(divide(9, 0));
print("\n");
