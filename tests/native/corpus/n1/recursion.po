## N1 recursion and mutual recursion.

fun fact(value: int): int {
    if value <= 1 {
        return 1;
    }
    return value * fact(value - 1);
}
println(fact(6));

fun fib(value: int): int {
    if value < 2 {
        return value;
    }
    return fib(value - 1) + fib(value - 2);
}
println(fib(10));

fun even(value: int): bool {
    if value == 0 {
        return true;
    }
    return odd(value - 1);
}

fun odd(value: int): bool {
    if value == 0 {
        return false;
    }
    return even(value - 1);
}
println(even(10));
println(odd(10));
