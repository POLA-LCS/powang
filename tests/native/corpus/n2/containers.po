## N2 arrays, maps, sets and tuples.

values := [1, 2, 3];
values[0] = 9;
println(values);
println(values[-1]);
println(values[0 >> 2]);
println(values + [4, 5]);
println(values - 1);
println(values - [2]);

entry := ["a" >> 1, "b" >> 2];
entry["c"] = 3;
println(entry);
println(entry["b"]);

unique := [/1, 2, 2, 3];
println(unique);

pair := .[1, 2];
println(pair);
println(pair[0] + pair[1]);
