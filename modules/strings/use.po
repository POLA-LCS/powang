## str helpers backed by src/stdlib_strings.py.
## Text is Unicode code point based: size, char_code and slicing count code
## points, not UTF-8 bytes. Invalid input raises a catchable [EXTERN ERROR].

export extern fun trim(text: str): str >> "stdlib_strings.trim";
export extern fun upper(text: str): str >> "stdlib_strings.upper";
export extern fun lower(text: str): str >> "stdlib_strings.lower";
export extern fun replace(text: str, old: str, new: str): str >> "stdlib_strings.replace";
export extern fun contains(text: str, sub: str): bool >> "stdlib_strings.contains";
export extern fun starts_with(text: str, prefix: str): bool >> "stdlib_strings.starts_with";
export extern fun ends_with(text: str, suffix: str): bool >> "stdlib_strings.ends_with";
export extern fun slice(text: str, start: int, end: int): str >> "stdlib_strings.slice";
export extern fun split(text: str, sep: str): arr >> "stdlib_strings.split";
export extern fun join(items: arr, sep: str): str >> "stdlib_strings.join";
export extern fun repeat(text: str, count: int): str >> "stdlib_strings.repeat";
export extern fun pad_left(text: str, width: int, fill: str = " "): str >> "stdlib_strings.pad_left";
export extern fun pad_right(text: str, width: int, fill: str = " "): str >> "stdlib_strings.pad_right";
export extern fun char_code(char: str): int >> "stdlib_strings.char_code";
export extern fun from_char_code(code: int): str >> "stdlib_strings.from_char_code";
export extern fun parse_int(text: str): int >> "stdlib_strings.parse_int";
export extern fun parse_number(text: str): num >> "stdlib_strings.parse_number";
export extern fun format_number(value: num, decimals: int): str >> "stdlib_strings.format_number";
