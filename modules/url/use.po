## URL encoding and query-str helpers backed by src/stdlib_url.py.
## Encoding uses application/x-www-form-urlencoded semantics: spaces become
## '+', reserved bytes are percent-encoded.

export extern fun encode(text: str): str >> "stdlib_url.encode";
export extern fun decode(text: str): str >> "stdlib_url.decode";
export extern fun parse_query(query: str): map >> "stdlib_url.parse_query";
export extern fun query_build(mapping: map): str >> "stdlib_url.query_build";
