## HTTP client backed by src/stdlib_http.py.
## Responses are maps with status (int), headers (map of lowercase names
## to values), body (str, UTF-8 with replacement), url (str) and
## elapsed_ms (num). Non-2xx statuses are returned, not raised.
## Failures raise a catchable [EXTERN ERROR] whose message starts with a kind
## prefix: timeout:, dns:, connect:, tls:, protocol: or invalid url:.

export extern fun get(url: str, headers: map = [], timeout_ms: int = 10000, follow_redirects: bool = true, verify_tls: bool = true): map >> "stdlib_http.get";
export extern fun post(url: str, body: str = "", headers: map = [], timeout_ms: int = 10000, follow_redirects: bool = true, verify_tls: bool = true): map >> "stdlib_http.post";
export extern fun request(method: str, url: str, body: str = "", headers: map = [], timeout_ms: int = 10000, follow_redirects: bool = true, verify_tls: bool = true): map >> "stdlib_http.request";

## In-process server (ADR-0001 W28). The handler receives a request map with
## method, path, query, headers, body, remote_addr and request_id, and returns
## a map with status, headers and body. serve blocks until stopped; listen
## returns a per-run server id for stop. Options: workers (4), max_body_bytes
## (1048576), read_timeout_ms (10000) and host ("127.0.0.1").
export extern fun serve(port: int, handler: any, options: map = []): nova >> "stdlib_http_server.serve";
export extern fun listen(port: int, handler: any, options: map = []): int >> "stdlib_http_server.listen";
export extern fun stop(server: int): nova >> "stdlib_http_server.stop";
