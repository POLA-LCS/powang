## Structured logging. All output goes to stderr, so program output stays clean.

export extern fun debug(message: str): nova >> "stdlib_log.debug";
export extern fun info(message: str): nova >> "stdlib_log.info";
export extern fun warn(message: str): nova >> "stdlib_log.warn";
export extern fun err(message: str): nova >> "stdlib_log.error";
export extern fun with_fields(level: str, message: str, fields: map): nova >> "stdlib_log.with_fields";
export extern fun set_level(level: str): nova >> "stdlib_log.set_level";
export extern fun is_enabled(level: str): bool >> "stdlib_log.is_enabled";
export extern fun access(request_id: int, method: str, path: str, status: int, elapsed_ms: num): nova >> "stdlib_log.access";
