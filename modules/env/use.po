## Environment variable access backed by src/stdlib_env.py.
## `get` returns nova when the variable is unset; use `get_or` for a default.

export extern fun get(name: str): @str >> "stdlib_env.get";
export extern fun get_or(name: str, default: str): str >> "stdlib_env.get_or";
export extern fun has(name: str): boolean >> "stdlib_env.has";
